# Must be the SAME database NestJS uses (copy the value from nestjs/.env).
DATABASE_URL="postgresql://postgres:root@localhost:5432/personal_finance?schema=public"

# Must exactly match nestjs/.env JWT_SECRET
JWT_SECRET="change-me-to-a-long-random-string"
# Must match nestjs/.env; used only for trusted NestJS-to-FastAPI calls
FASTAPI_INTERNAL_API_KEY="replace-with-a-long-random-random-secret"
