# Same database as the FastAPI service (it reads the tables NestJS creates).
DATABASE_URL="postgresql://postgres:root@localhost:5432/personal_finance?schema=public"
# Use a long random string, e.g.:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN_SECONDS=86400
# Where the FastAPI analytics service runs
FASTAPI_BASE_URL="http://127.0.0.1:8000"
# Must match fastapi/.env; used only for trusted server-to-server AI calls
FASTAPI_INTERNAL_API_KEY="replace-with-a-long-random-secret"
PORT=3000
